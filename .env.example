# Local run (make / make run): these are also the built-in defaults, so .env is optional.
DATABASE_URL=sqlite:///./moil.db
DATA_MODE=demo
API_KEY=change-me
MODEL_DIR=./artifacts
COG_PATH=data/cogs/prospectivity.tif
CORS_ORIGINS=["*"]

# Docker stack (make docker-up) instead: use Postgres and the container paths.
# DATABASE_URL=postgresql+psycopg://moil:moil@db:5432/moil
# MODEL_DIR=/app/artifacts
# COG_PATH=/data/cogs/prospectivity.tif
